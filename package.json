{
  "name": "agentfit",
  "version": "0.1.0",
  "description": "Local-first fitness tests for AI coding-agent instruction files.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyylian/agentfit.git"
  },
  "homepage": "https://github.com/kyylian/agentfit#readme",
  "bugs": {
    "url": "https://github.com/kyylian/agentfit/issues"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "agentfit": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs/*.md",
    "examples/demo",
    "examples/reports/demo-*.json",
    "examples/reports/demo-*.md",
    "action.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm lint && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agents",
    "agents-md",
    "codex",
    "claude",
    "cursor",
    "copilot",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "simple-git": "^3.29.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.8"
  }
}
